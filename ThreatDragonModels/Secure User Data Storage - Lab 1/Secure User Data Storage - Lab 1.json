  "summary": {
    "title": "Secure User Data Storage - Lab 1",
    "owner": "Zawadh",
    "description": "A Python command-line application that stores user credentials (username, password, email) in a local JSON file. Passwords are encrypted using Fernet (AES), and each record is protected with a SHA-256 integrity hash. The application detects tampering by comparing a monitored file against reference hashes, with results logged to an audit file.",
    "id": 0
  },
